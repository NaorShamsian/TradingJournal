PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/trading_journal?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
# How often the backend pulls new trades from MT5 (seconds). 0 = disabled.
SYNC_INTERVAL_SECONDS=60
# Python executable used to run sync/mt5_sync_once.py (must have `pip install -r sync/requirements.txt`)
PYTHON_PATH=python
